{
  "name": "fiber-optic-data-cables",
  "version": "1.0.0",
  "description": "Fiber-optic data cables motion graphic (Remotion + Three.js / WebGL 2), 4K compositions",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/three": "^0.181.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lint": "eslint src && tsc",
    "typecheck": "tsc --noEmit",
    "render:v1:1080p": "remotion render FiberOpticCables-V1-Reference out/version-1-fiber-optic-data-cables-1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render FiberOpticCables-V1-Reference out/version-1-fiber-optic-data-cables-4k.mp4",
    "still:v1": "remotion still FiberOpticCables-V1-Reference out/version-1-fiber-optic-data-cables-still.png --frame=150 --scale=0.5",
    "render:v2:1080p": "remotion render FiberOpticCables-V2-AmberPalette out/version-2-fiber-optic-data-cables-amber-palette-1080p.mp4 --scale=0.5",
    "render:v2:4k": "remotion render FiberOpticCables-V2-AmberPalette out/version-2-fiber-optic-data-cables-amber-palette-4k.mp4",
    "still:v2": "remotion still FiberOpticCables-V2-AmberPalette out/version-2-fiber-optic-data-cables-amber-palette-still.png --frame=150 --scale=0.5",
    "render:all:1080p": "npm run render:v1:1080p && npm run render:v2:1080p",
    "master": "bash scripts/master.sh"
  },
  "sideEffects": [
    "*.css"
  ]
}
