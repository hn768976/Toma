{
  "name": "finance-infographics",
  "version": "1.0.0",
  "description": "Remotion + Three.js 4K composition",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:v1:4k": "remotion render FinanceInfographics-V1-SlowPush-4K out/finance-infographics-v1-slow-push-4k.mp4",
    "render:v2:4k": "remotion render FinanceInfographics-V2-OrbitGlide-4K out/finance-infographics-v2-orbit-glide-4k.mp4",
    "render:v1:1080p": "remotion render FinanceInfographics-V1-SlowPush-4K out/finance-infographics-v1-slow-push-1080p.mp4 --scale=0.5 --crf=18",
    "render:v2:1080p": "remotion render FinanceInfographics-V2-OrbitGlide-4K out/finance-infographics-v2-orbit-glide-1080p.mp4 --scale=0.5 --crf=18",
    "still:v1": "remotion still FinanceInfographics-V1-SlowPush-4K out/finance-infographics-v1-frame300-4k.png --frame=300",
    "still:v2": "remotion still FinanceInfographics-V2-OrbitGlide-4K out/finance-infographics-v2-frame300-4k.png --frame=300",
    "lint": "tsc --noEmit"
  }
}
