{
  "name": "liquid-glitter-silk",
  "version": "1.0.0",
  "description": "Iridescent glitter liquid-silk motion loop (WebGL2 shader, 4K Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render LiquidGlitterSilk-V1-Reference out/LiquidGlitterSilk-V1-Reference-1080p.mp4 --scale=0.5",
    "render:v2": "remotion render LiquidGlitterSilk-V2-AquaGold out/LiquidGlitterSilk-V2-AquaGold-1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render LiquidGlitterSilk-V1-Reference out/LiquidGlitterSilk-V1-Reference-4k.mp4",
    "render:v2:4k": "remotion render LiquidGlitterSilk-V2-AquaGold out/LiquidGlitterSilk-V2-AquaGold-4k.mp4",
    "still:v1": "remotion still LiquidGlitterSilk-V1-Reference out/LiquidGlitterSilk-V1-Reference-4k.png --frame=60"
  },
  "allowScripts": {
    "esbuild": false
  }
}
