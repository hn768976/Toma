{
  "name": "tile-wave",
  "version": "1.0.0",
  "description": "Pillar-grid valley wave (Three.js instanced pillars + accumulation motion blur), 4K, 30 fps, 267 frames.",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render TileWave-V1 out/TileWave-V1_1080p.mp4 --scale=0.5",
    "render:v2": "remotion render TileWave-V2 out/TileWave-V2_1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render TileWave-V1 out/TileWave-V1_4K.mp4",
    "render:v2:4k": "remotion render TileWave-V2 out/TileWave-V2_4K.mp4",
    "still:4k": "remotion still TileWave-V1 out/TileWave-V1_4K_still.png --frame=120",
    "upgrade": "remotion upgrade"
  },
  "allowScripts": {
    "esbuild": false
  }
}
