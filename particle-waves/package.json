{
  "name": "particle-waves",
  "version": "1.0.0",
  "description": "Teal particle-wave cloth (Three.js / WebGL 2 particles) \u2014 Remotion, 4K @ 30 fps",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@types/three": "^0.180.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render ParticleWaves-V1 out/ParticleWaves-V1-1080p.mp4 --gl=swangle --scale=0.5 --codec=h264",
    "render:v1:4k": "remotion render ParticleWaves-V1 out/ParticleWaves-V1-4k.mp4 --gl=swangle --codec=h264",
    "render:v2": "remotion render ParticleWaves-V2 out/ParticleWaves-V2-1080p.mp4 --gl=swangle --scale=0.5 --codec=h264",
    "render:v2:4k": "remotion render ParticleWaves-V2 out/ParticleWaves-V2-4k.mp4 --gl=swangle --codec=h264"
  },
  "allowScripts": {
    "esbuild": false
  }
}
