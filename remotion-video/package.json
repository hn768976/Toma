{
  "name": "remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/tailwind-v4": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "tailwindcss": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:wave:1080p": "remotion render ParticleWave1080p out/particle-wave-blue-1080p.mp4 --codec=h264 --image-format=png --crf=16",
    "render:wave:4k": "remotion render ParticleWave4K out/particle-wave-blue-4k.mp4 --codec=h264 --image-format=png --crf=16",
    "render:wave:mono:1080p": "remotion render ParticleWaveMono1080p out/particle-wave-mono-1080p.mp4 --codec=h264 --image-format=png --crf=16",
    "render:wave:mono:4k": "remotion render ParticleWaveMono4K out/particle-wave-mono-4k.mp4 --codec=h264 --image-format=png --crf=16"
  },
  "sideEffects": [
    "*.css",
    "./src/load-fonts.ts"
  ]
}
