{
  "name": "remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/tailwind-v4": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "tailwindcss": "4.0.0",
    "three": "^0.182.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/three": "^0.182.0",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render GlassPanesRing-V1-1080p out/V1_FrostedPanesRing_1920x1080_30fps.mp4 --codec=h264 --image-format=png --crf=15 --gl=swangle --muted",
    "render:v2": "remotion render GlassCardsRing-V2-1080p out/V2_GlossyCardsRing_1920x1080_30fps.mp4 --codec=h264 --image-format=png --crf=15 --gl=swangle --muted",
    "render:v1-4k": "remotion render GlassPanesRing-V1-4K out/V1_FrostedPanesRing_3840x2160_30fps.mp4 --codec=h264 --image-format=png --crf=14 --gl=swangle --muted",
    "render:v2-4k": "remotion render GlassCardsRing-V2-4K out/V2_GlossyCardsRing_3840x2160_30fps.mp4 --codec=h264 --image-format=png --crf=14 --gl=swangle --muted",
    "render:all-4k": "npm run render:v1-4k && npm run render:v2-4k"
  },
  "sideEffects": [
    "*.css",
    "./src/load-fonts.ts"
  ]
}
