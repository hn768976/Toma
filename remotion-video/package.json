{
  "name": "remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/tailwind-v4": "4.0.515",
    "@types/three": "^0.186.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "tailwindcss": "4.0.0",
    "three": "^0.186.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:eye": "node scripts/render-eye.mjs",
    "render:eye:4k": "node scripts/render-eye.mjs --4k",
    "model:clean": "python3 tools/clean-model.py assets-src/Meshy_AI_Ocean_Gaze.glb assets-src/eye_clean_raw.glb",
    "model:optimize": "gltf-transform weld assets-src/eye_clean_raw.glb assets-src/eye_welded.glb && gltf-transform simplify --ratio 0.6 --error 0.001 assets-src/eye_welded.glb assets-src/eye_simplified.glb && gltf-transform prune assets-src/eye_simplified.glb public/models/eye.glb"
  },
  "sideEffects": [
    "*.css",
    "./src/load-fonts.ts"
  ]
}
