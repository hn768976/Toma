{
  "name": "remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/tailwind-v4": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "tailwindcss": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "^2.0.2"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "generate:map": "node scripts/generate-world-dots.mjs",
    "generate:grain": "node scripts/generate-grain.mjs",
    "render:1080": "remotion render DataNetwork1080Blue out/data-network-1080-blue.mp4 --codec=h264 --crf=18 --jpeg-quality=100 --color-space=bt709",
    "render:1080:green": "remotion render DataNetwork1080Green out/data-network-1080-green.mp4 --codec=h264 --crf=18 --jpeg-quality=100 --color-space=bt709",
    "render:4k": "remotion render DataNetwork4KBlue out/data-network-4k-blue.mp4 --codec=h264 --crf=16 --jpeg-quality=100 --color-space=bt709",
    "render:4k:green": "remotion render DataNetwork4KGreen out/data-network-4k-green.mp4 --codec=h264 --crf=16 --jpeg-quality=100 --color-space=bt709"
  },
  "sideEffects": [
    "*.css",
    "./src/load-fonts.ts"
  ]
}
