{
  "name": "remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@remotion/cli": "4.0.515",
    "@remotion/tailwind-v4": "4.0.515",
    "@remotion/three": "^4.0.515",
    "postprocessing": "^6.39.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "tailwindcss": "4.0.0",
    "three": "^0.186.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render FlightGridV1-1080p out/FlightGrid-V1-1080p.mp4 --muted --crf=14 --x264-preset=slow",
    "render:v2": "remotion render FlightGridV2-1080p out/FlightGrid-V2-1080p.mp4 --muted --crf=14 --x264-preset=slow",
    "render:v1-4k": "remotion render FlightGridV1-4K out/FlightGrid-V1-4K.mp4 --muted --crf=14 --x264-preset=slow",
    "render:v2-4k": "remotion render FlightGridV2-4K out/FlightGrid-V2-4K.mp4 --muted --crf=14 --x264-preset=slow",
    "render:deliverables": "npm run render:v1 && npm run render:v2"
  },
  "sideEffects": [
    "*.css",
    "./src/load-fonts.ts"
  ]
}
