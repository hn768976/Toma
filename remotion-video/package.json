{
  "name": "remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/tailwind-v4": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "tailwindcss": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:phishing:1080p": "remotion render PhishingAttack1080p out/phishing-attack-1080p.mp4 --codec=h264 --image-format=png --crf=17 --muted",
    "render:phishing:4k": "remotion render PhishingAttack4K   out/phishing-attack-4k.mp4   --codec=h264 --image-format=png --crf=17 --muted",
    "render:hacked:1080p": "remotion render SystemHacked1080p  out/system-hacked-1080p.mp4  --codec=h264 --image-format=png --crf=17 --muted",
    "render:hacked:4k": "remotion render SystemHacked4K     out/system-hacked-4k.mp4     --codec=h264 --image-format=png --crf=17 --muted",
    "render:all": "npm run render:phishing:1080p && npm run render:hacked:1080p && npm run render:phishing:4k && npm run render:hacked:4k"
  },
  "sideEffects": [
    "*.css",
    "./src/load-fonts.ts",
    "./src/glitch-alert/fonts.ts"
  ]
}
