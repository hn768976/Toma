{
  "name": "remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/tailwind-v4": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "tailwindcss": "4.0.0",
    "three": "^0.181.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/three": "^0.181.0",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "textures": "node scripts/fetch-nasa-textures.mjs",
    "render:1": "remotion render EarthOrbitDrift-1080p out/Earth_1_OrbitDrift_1080p.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:1-4k": "remotion render EarthOrbitDrift-4K out/Earth_1_OrbitDrift_4K.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:2": "remotion render EarthLowHorizon-1080p out/Earth_2_LowHorizon_1080p.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:2-4k": "remotion render EarthLowHorizon-4K out/Earth_2_LowHorizon_4K.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:3": "remotion render EarthDawnReveal-1080p out/Earth_3_DawnReveal_1080p.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:3-4k": "remotion render EarthDawnReveal-4K out/Earth_3_DawnReveal_4K.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:4": "remotion render EarthNightPass-1080p out/Earth_4_NightPass_1080p.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:4-4k": "remotion render EarthNightPass-4K out/Earth_4_NightPass_4K.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:5": "remotion render EarthSunriseCrest-1080p out/Earth_5_SunriseCrest_1080p.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:5-4k": "remotion render EarthSunriseCrest-4K out/Earth_5_SunriseCrest_4K.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:6": "remotion render EarthDeepSpaceMeteor-1080p out/Earth_6_DeepSpaceMeteor_1080p.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:6-4k": "remotion render EarthDeepSpaceMeteor-4K out/Earth_6_DeepSpaceMeteor_4K.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:7": "remotion render EarthTimelapseStreak-1080p out/Earth_7_TimelapseStreak_1080p.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:7-4k": "remotion render EarthTimelapseStreak-4K out/Earth_7_TimelapseStreak_4K.mp4 --codec=h264 --crf=15 --color-space=bt709 --muted",
    "render:all": "npm run render:1 && npm run render:2 && npm run render:3 && npm run render:4 && npm run render:5 && npm run render:6 && npm run render:7",
    "render:all4k": "npm run render:1-4k && npm run render:2-4k && npm run render:3-4k && npm run render:4-4k && npm run render:5-4k && npm run render:6-4k && npm run render:7-4k"
  },
  "sideEffects": [
    "*.css",
    "./src/load-fonts.ts"
  ]
}
