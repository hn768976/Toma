{
  "name": "pool-caustics-4k",
  "version": "1.0.0",
  "description": "Top-down swimming-pool water with caustics - two 4K Remotion compositions (WebGL 2 shader)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render PoolCausticsV1 out/pool-caustics-v1-1080p.mp4 --scale=0.5",
    "render:v2": "remotion render PoolCausticsV2 out/pool-caustics-v2-tilted-glide-1080p.mp4 --scale=0.5",
    "render:all": "npm run render:v1 && npm run render:v2",
    "render:v1:4k": "remotion render PoolCausticsV1 out/pool-caustics-v1-4k.mp4",
    "render:v2:4k": "remotion render PoolCausticsV2 out/pool-caustics-v2-tilted-glide-4k.mp4"
  },
  "allowScripts": {
    "esbuild": false
  }
}
