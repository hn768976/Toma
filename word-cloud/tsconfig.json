{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2018"],
    "types": ["@types/web"]
  },
  "include": ["src"]
}
