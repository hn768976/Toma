{
  "name": "metrics-counter",
  "version": "1.0.0",
  "description": "Social Metrics Counter — oversized type on an angled, shallow-focus plane (Remotion, 4K/30fps)",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion bundle",
    "render:v1": "remotion render V1-MetricsCounterLight out/V1_MetricsCounterLight.mp4 --scale=1 --crf=16",
    "render:v2": "remotion render V2-MetricsCounterDark out/V2_MetricsCounterDark.mp4 --scale=1 --crf=16",
    "still:v1": "remotion still V1-MetricsCounterLight out/V1_MetricsCounterLight.png --frame=550 --scale=1",
    "still:v2": "remotion still V2-MetricsCounterDark out/V2_MetricsCounterDark.png --frame=550 --scale=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/fonts": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
