{
  "name": "data-wall",
  "version": "1.0.0",
  "description": "4K financial data wall animation (Remotion)",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lint": "tsc",
    "render:blue": "remotion render DataWallBlue out/datawall-blue.mp4 --codec=h264 --crf=12 --concurrency=8",
