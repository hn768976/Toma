{
  "name": "dna-helix-growth",
  "version": "1.0.0",
  "description": "DNA helix growth - Remotion + Three.js (WebGL 2) motion graphic, 4K masters",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/three": "^0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render:v1": "remotion render DnaHelixGrowth-V1 out/dna-helix-growth-v1-1080p.mp4 --scale=0.5",
    "render:v2": "remotion render DnaHelixGrowth-V2 out/dna-helix-growth-v2-1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render DnaHelixGrowth-V1 out/dna-helix-growth-v1-4k.mp4",
    "render:v2:4k": "remotion render DnaHelixGrowth-V2 out/dna-helix-growth-v2-4k.mp4",
    "render": "npm run render:v1 && npm run render:v2",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
