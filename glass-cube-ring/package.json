{
  "name": "glass-cube-ring",
  "version": "1.0.0",
  "description": "Tumbling ring of iridescent glass cubes (Remotion + Three.js, 4K)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@types/three": "0.186.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render GlassCubeRing-V1 out/GlassCubeRing-V1_1080p.mp4 --scale=0.5 --codec=h264 --crf=16",
    "render:v2": "remotion render GlassCubeRing-V2 out/GlassCubeRing-V2_1080p.mp4 --scale=0.5 --codec=h264 --crf=16",
    "render:v1:4k": "remotion render GlassCubeRing-V1 out/GlassCubeRing-V1_2160p.mp4 --codec=h264 --crf=16",
    "render:v2:4k": "remotion render GlassCubeRing-V2 out/GlassCubeRing-V2_2160p.mp4 --codec=h264 --crf=16"
  },
  "allowScripts": {
    "esbuild": false
  }
}
