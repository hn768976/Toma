{
  "name": "warp-tunnel",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/tailwind-v4": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render WarpTunnel-V1-Reference out/warp-tunnel-v1-1080p.mp4 --scale=0.5 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "render:v1:4k": "remotion render WarpTunnel-V1-Reference out/warp-tunnel-v1-4k.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "render:v2": "remotion render WarpTunnel-V2-BankingOrbit out/warp-tunnel-v2-1080p.mp4 --scale=0.5 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "render:v2:4k": "remotion render WarpTunnel-V2-BankingOrbit out/warp-tunnel-v2-4k.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709",
    "render:all": "npm run render:v1 && npm run render:v2"
  },
  "sideEffects": [
    "*.css"
  ]
}
