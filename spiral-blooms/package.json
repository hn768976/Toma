{
  "name": "spiral-blooms",
  "version": "1.0.0",
  "description": "Spiral Blooms – bokeh spiral-flower field (Three.js / WebGL 2 shaders) in 4K, Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/three": "0.180.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render SpiralBlooms-V1-Reference out/SpiralBlooms-V1-Reference-1080p.mp4 --scale=0.5",
    "render:v2": "remotion render SpiralBlooms-V2-DollyRackFocus out/SpiralBlooms-V2-DollyRackFocus-1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render SpiralBlooms-V1-Reference out/SpiralBlooms-V1-Reference-2160p.mp4",
    "render:v2:4k": "remotion render SpiralBlooms-V2-DollyRackFocus out/SpiralBlooms-V2-DollyRackFocus-2160p.mp4",
    "render:all": "npm run render:v1 && npm run render:v2",
    "still": "remotion still SpiralBlooms-V1-Reference out/still.png --frame=0 --scale=0.25"
  },
  "allowScripts": {
    "esbuild": false
  }
}
