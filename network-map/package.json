{
  "name": "network-map",
  "version": "1.0.0",
  "description": "4K dotted network map animation (global + Europe) built with Remotion",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lint": "tsc --noEmit",
    "render:global": "remotion render NetworkMapGlobal out/network-global.mp4 --codec=h264 --crf=12",
    "render:europe": "remotion render NetworkMapEurope out/network-europe.mp4 --codec=h264 --crf=12"
  },
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
