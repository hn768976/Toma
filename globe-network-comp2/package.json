{
  "name": "globe-network-comp2",
  "version": "1.0.0",
  "description": "Composition 2 - Earth at blue hour with a growing global network mesh. 4K UHD Remotion + Three.js project.",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/three": "^0.180.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render EarthNetwork-V1-Reference out/Comp2_V1_Reference_1080p.mp4 --scale=0.5",
    "render:v2": "remotion render EarthNetwork-V2-OrbitalPullback out/Comp2_V2_OrbitalPullback_1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render EarthNetwork-V1-Reference out/Comp2_V1_Reference_4K.mp4",
    "render:v2:4k": "remotion render EarthNetwork-V2-OrbitalPullback out/Comp2_V2_OrbitalPullback_4K.mp4",
    "build:assets": "python3 scripts/build_assets.py"
  },
  "sideEffects": [
    "*.css"
  ]
}
