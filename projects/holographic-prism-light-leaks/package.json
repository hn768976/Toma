{
  "name": "holographic-prism-light-leaks",
  "version": "1.0.0",
  "description": "Holographic prism light leaks - WebGL 2 shader motion graphic (Remotion, 4K)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1:4k": "remotion render HoloPrism-V1-Match-4K out/HoloPrism-V1-Match-4K.mp4",
    "render:v2:4k": "remotion render HoloPrism-V2-LowAngleTracking-4K out/HoloPrism-V2-LowAngleTracking-4K.mp4",
    "render:delivery": "bash ./render-delivery.sh out",
    "still:v1": "remotion still HoloPrism-V1-Match-4K out/HoloPrism-V1-Match-4K-still.png --frame=60"
