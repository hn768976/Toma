{
  "name": "dna-sequence-grid",
  "version": "1.0.0",
  "description": "DNA sequencing gel grid motion graphic (WebGL 2 shader + Remotion), 4K compositions",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "@remotion/tailwind-v4": "4.0.543",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render DnaSequence-V1-Match \"out/Version-1_DNA-Sequencing-Grid_1080p.mp4\" --scale=0.5 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "render:v1:4k": "remotion render DnaSequence-V1-Match \"out/Version-1_DNA-Sequencing-Grid_4K.mp4\" --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "render:v2": "remotion render DnaSequence-V2-FluorescentPalette \"out/Version-2_DNA-Sequencing-Grid_Fluorescent-Palette_1080p.mp4\" --scale=0.5 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "render:v2:4k": "remotion render DnaSequence-V2-FluorescentPalette \"out/Version-2_DNA-Sequencing-Grid_Fluorescent-Palette_4K.mp4\" --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "render:all": "npm run render:v1 && npm run render:v2"
  },
  "sideEffects": [
    "*.css"
  ]
}
