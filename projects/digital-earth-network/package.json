{
  "name": "digital-earth-network",
  "version": "1.0.0",
  "description": "Digital Earth data-network motion graphic (Three.js + Remotion), 4K compositions",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/roboto-mono": "^5.2.8",
    "@remotion/cli": "4.0.543",
    "@remotion/tailwind-v4": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "tailwindcss": "4.0.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/three": "^0.181.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render EarthNetwork-V1-Match \"out/Version-1_Digital-Earth-Data-Network_1080p.mp4\" --scale=0.5 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "render:v1:4k": "remotion render EarthNetwork-V1-Match \"out/Version-1_Digital-Earth-Data-Network_4K.mp4\" --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "render:v2": "remotion render EarthNetwork-V2-OrbitalCamera \"out/Version-2_Digital-Earth-Data-Network_Orbital-Camera_1080p.mp4\" --scale=0.5 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "render:v2:4k": "remotion render EarthNetwork-V2-OrbitalCamera \"out/Version-2_Digital-Earth-Data-Network_Orbital-Camera_4K.mp4\" --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "render:all": "npm run render:v1 && npm run render:v2"
  },
  "sideEffects": [
    "*.css"
  ]
}
