{
  "name": "light-streams",
  "version": "1.0.0",
  "description": "Flowing 3D light-line surfaces (Three.js / WebGL 2) \u2014 4K Remotion compositions",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "^0.187.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/three": "^0.187.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render LightStreams-V1 out/LightStreams-V1-1080p.mp4 --scale=0.5",
    "render:v2": "remotion render LightStreams-V2 out/LightStreams-V2-1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render LightStreams-V1 out/LightStreams-V1-4k.mp4",
    "render:v2:4k": "remotion render LightStreams-V2 out/LightStreams-V2-4k.mp4",
    "render:all": "npm run render:v1 && npm run render:v2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
