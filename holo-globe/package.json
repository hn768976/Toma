{
  "name": "holo-globe",
  "version": "1.0.0",
  "description": "Holographic binary-earth globe (Remotion + Three.js), 4K UHD, 30 fps",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "d3-geo": "3.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "0.180.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/d3-geo": "3.1.0",
    "@types/react": "19.2.7",
    "@types/three": "0.180.0",
    "@types/topojson-client": "3.1.5",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render HoloGlobeV1 out/HoloGlobe_V1_1080p.mp4 --scale=0.5",
    "render:v2": "remotion render HoloGlobeV2 out/HoloGlobe_V2_1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render HoloGlobeV1 out/HoloGlobe_V1_4K.mp4",
    "render:v2:4k": "remotion render HoloGlobeV2 out/HoloGlobe_V2_4K.mp4",
    "still:v1": "remotion still HoloGlobeV1 out/HoloGlobe_V1_still.png --frame=200"
  },
  "allowScripts": {
    "esbuild": false
  }
}
