{
  "name": "crumpled-grid-paper",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render CrumpledGridPaper-V1 out/CrumpledGridPaper-V1_1080p.mp4 --codec=h264 --scale=0.5 --crf=16 --color-space=bt709 --enforce-audio-track",
    "render:v1:4k": "remotion render CrumpledGridPaper-V1 out/CrumpledGridPaper-V1_4K.mp4 --codec=h264 --crf=16 --color-space=bt709 --enforce-audio-track",
    "render:v2": "remotion render CrumpledGridPaper-V2 out/CrumpledGridPaper-V2_1080p.mp4 --codec=h264 --scale=0.5 --crf=16 --color-space=bt709 --enforce-audio-track",
    "render:v2:4k": "remotion render CrumpledGridPaper-V2 out/CrumpledGridPaper-V2_4K.mp4 --codec=h264 --crf=16 --color-space=bt709 --enforce-audio-track",
    "render:all": "npm run render:v1 && npm run render:v2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
