{
  "name": "hydrogen-molecules",
  "version": "1.0.0",
  "description": "H2 hydrogen molecules — 4K Remotion composition (Canvas 2D, 2.5D depth of field)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1:4k": "remotion render HydrogenMolecules-V1-Match out/Version-1-Hydrogen-Molecules-Match-4k.mp4",
    "render:v2:4k": "remotion render HydrogenMolecules-V2-OrbitCamera out/Version-2-Hydrogen-Molecules-Orbit-Camera-4k.mp4",
    "render:v1:1080p": "remotion render HydrogenMolecules-V1-Match out/Version-1-Hydrogen-Molecules-Match-1080p.mp4 --scale=0.5",
    "render:v2:1080p": "remotion render HydrogenMolecules-V2-OrbitCamera out/Version-2-Hydrogen-Molecules-Orbit-Camera-1080p.mp4 --scale=0.5",
    "still:4k": "remotion still HydrogenMolecules-V1-Match out/still-4k.png --frame=240"
  },
  "sideEffects": [
    "*.css"
  ]
}
