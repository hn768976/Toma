{
  "name": "toma-candle-chart",
  "version": "1.0.0",
  "private": true,
  "description": "4K candlestick trading chart macro-shot animation in Remotion",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render CandleChart out/candle-chart.mp4 --codec=h264 --crf=12 --concurrency=8",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "verify:loop": "node scripts/verify-loop.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "remotion": "4.0.516",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.8.3"
  }
}
