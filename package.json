{
  "name": "neon-streaks",
  "version": "1.0.0",
  "description": "Procedural looping neon light-streak background, built in Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/zod-types": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render NeonStreaks out/neon-streaks.mp4 --crf 16",
    "render:vertical": "remotion render NeonStreaksVertical out/neon-streaks-vertical.mp4 --crf 16",
    "render:alpha": "remotion render NeonStreaksAlpha out/neon-streaks-alpha.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "stills": "node scripts/stills.mjs",
    "check:loop": "node scripts/check-loop.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}
