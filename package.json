  },
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.7.3"
  }
}
