{
  "name": "data-curve-countries",
  "version": "1.0.0",
  "description": "4K country data-curve animations in Remotion (UK / USA / China)",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion bundle",
    "render:uk": "remotion render DataCurveUK out/data-curve-uk.mp4 --codec=h264 --crf=12",
    "render:usa": "remotion render DataCurveUSA out/data-curve-usa.mp4 --codec=h264 --crf=12",
    "render:china": "remotion render DataCurveChina out/data-curve-china.mp4 --codec=h264 --crf=12",
    "render:all": "npm run render:uk && npm run render:usa && npm run render:china",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hn768976/Toma.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/hn768976/Toma/issues"
  },
  "homepage": "https://github.com/hn768976/Toma#readme",
  "dependencies": {
    "@remotion/cli": "^4.0.517",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.517"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "world-atlas": "^2.0.2"
  },
  "private": true
}
