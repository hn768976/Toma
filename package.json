{
  "name": "candle-macro",
  "version": "1.0.0",
  "private": true,
  "description": "4K candlestick macro animation - bear and bull variants",
  "scripts": {
    "start": "remotion studio",
    "build:bear": "remotion render CandleMacroBear out/candle-bear.mp4 --codec=h264 --crf=12",
    "build:bull": "remotion render CandleMacroBull out/candle-bull.mp4 --codec=h264 --crf=12",
    "verify:loop": "node scripts/verify-loop.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.517",
    "@remotion/cli": "^4.0.517",
    "@remotion/google-fonts": "^4.0.517",
    "@remotion/renderer": "^4.0.517",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.517"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  }
}
