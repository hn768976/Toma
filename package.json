{
  "name": "toma-code-flythrough",
  "version": "1.0.0",
  "private": true,
  "description": "4K code flythrough animation rendered on canvas with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render CodeFlythrough out/code-flythrough.mp4 --codec=h264 --crf=12 --concurrency=8",
    "still": "remotion still CodeFlythrough out/frame.png",
    "verify-loop": "node scripts/verify-loop.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "@remotion/google-fonts": "4.0.516",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.516"
  },
  "devDependencies": {
    "@remotion/renderer": "4.0.516",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "typescript": "5.9.3"
  }
}
