{
  "name": "code-tunnel-title",
  "version": "1.0.0",
  "private": true,
  "description": "4K code-tunnel title card animation built with Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "preview": "remotion render CodeTunnelTitle out/code-tunnel-preview.mp4 --codec=h264 --crf=18 --scale=0.5 --concurrency=8",
    "render": "remotion render CodeTunnelTitle out/code-tunnel-4k.mp4 --codec=h264 --crf=12 --concurrency=8",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.517",
    "@remotion/google-fonts": "4.0.517",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.517"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  }
}
