{
  "name": "toma-ticker-board",
  "version": "1.0.0",
  "private": true,
  "description": "4K macro financial ticker board animation built with Remotion",
  "scripts": {
    "start": "remotion studio",
    "render": "remotion render TickerBoard out/ticker-board.mov --codec=prores --prores-profile=hq --pixel-format=yuv422p10le --muted --concurrency=4",
    "render:mp4": "remotion render TickerBoard out/ticker-board.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --muted --concurrency=4",
    "still": "remotion still TickerBoard out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.516"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.2"
  }
}
