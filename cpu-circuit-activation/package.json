    "render:v1:4k": "remotion render CpuActivation-V1-Reference out/cpu-activation-v1-4k.mp4",
    "render:v2:4k": "remotion render CpuActivation-V2-EmberGold out/cpu-activation-v2-4k.mp4",
    "render:all": "npm run render:v1 && npm run render:v2"
  },
  "allowScripts": {
    "esbuild": false
  }
