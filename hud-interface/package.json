{
  "name": "hud-interface",
  "version": "1.0.0",
  "description": "Sci-fi holographic HUD interface motion graphic (Remotion, WebGL 2 shader + SVG, 4K)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render HudInterface-V1-4K out/Version1_HUD-Interface_1080p.mp4 --scale=0.5",
    "render:v2": "remotion render HudInterface-V2-4K out/Version2_HUD-Interface_Amber-Palette_1080p.mp4 --scale=0.5",
    "render:all": "npm run render:v1 && npm run render:v2",
    "render:v1:4k": "remotion render HudInterface-V1-4K out/Version1_HUD-Interface_4K.mp4",
    "render:v2:4k": "remotion render HudInterface-V2-4K out/Version2_HUD-Interface_Amber-Palette_4K.mp4",
    "upgrade": "remotion upgrade"
  },
  "allowScripts": {
    "esbuild": false
  }
}
