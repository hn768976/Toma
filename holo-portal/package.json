{
  "name": "holo-portal",
  "version": "1.0.0",
  "description": "Holographic data portal motion graphic (4K Remotion compositions, 1080p H.264 deliverables)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537",
    "@remotion/tailwind-v4": "4.0.537",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:reference": "remotion render HoloPortal out/HoloPortal_reference_1080p.mp4 --codec=h264 --scale=0.5 --pixel-format=yuv420p",
    "render:orbit": "remotion render HoloPortalOrbit out/HoloPortal_orbit_1080p.mp4 --codec=h264 --scale=0.5 --pixel-format=yuv420p",
    "render:reference:4k": "remotion render HoloPortal out/HoloPortal_reference_4k.mp4 --codec=h264 --pixel-format=yuv420p",
    "render:orbit:4k": "remotion render HoloPortalOrbit out/HoloPortal_orbit_4k.mp4 --codec=h264 --pixel-format=yuv420p"
  },
  "sideEffects": [
    "*.css"
  ]
}
