{
  "name": "particle-collision-network",
  "version": "1.0.0",
  "description": "4K Remotion composition: plexus particle strands whose glowing orbs collide (Canvas 2D + custom depth-of-field engine)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1:4k": "remotion render V1-ParticleCollision-Original out/Version-1_Particle-Collision-Network_4K.mp4",
    "render:v1:1080p": "remotion render V1-ParticleCollision-Original out/Version-1_Particle-Collision-Network_1080p.mp4 --scale=0.5",
    "still:v1:4k": "remotion still V1-ParticleCollision-Original out/Version-1_Particle-Collision-Network_still_4K.png --frame=300 --image-format=png",
    "render:v2:4k": "remotion render V2-ParticleCollision-AuroraPalette out/Version-2_Particle-Collision-Network_Aurora-Palette_4K.mp4",
    "render:v2:1080p": "remotion render V2-ParticleCollision-AuroraPalette out/Version-2_Particle-Collision-Network_Aurora-Palette_1080p.mp4 --scale=0.5",
    "still:v2:4k": "remotion still V2-ParticleCollision-AuroraPalette out/Version-2_Particle-Collision-Network_Aurora-Palette_still_4K.png --frame=300 --image-format=png",
    "render:all:1080p": "npm run render:v1:1080p && npm run render:v2:1080p",
    "render:all:4k": "npm run render:v1:4k && npm run render:v2:4k"
  },
  "sideEffects": [
    "*.css"
  ]
}
