{
  "name": "neon-pipes",
  "version": "1.0.0",
  "description": "Neon Pipes – isometric neon pipe-chain loop (Three.js / WebGL 2) in 4K, Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/three": "0.180.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render NeonPipes-V1-Reference out/NeonPipes-V1-Reference-1080p.mp4 --scale=0.5",
    "render:v2": "remotion render NeonPipes-V2-EmberTeal out/NeonPipes-V2-EmberTeal-1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render NeonPipes-V1-Reference out/NeonPipes-V1-Reference-2160p.mp4",
    "render:v2:4k": "remotion render NeonPipes-V2-EmberTeal out/NeonPipes-V2-EmberTeal-2160p.mp4",
    "render:all": "npm run render:v1 && npm run render:v2",
    "still": "remotion still NeonPipes-V1-Reference out/still.png --frame=0 --scale=0.25"
  }
}
