{
  "name": "stack-network",
  "version": "1.0.0",
  "description": "Dev Stack Network - looping 4K motion graphics built with Remotion",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion bundle",
    "render:v1": "remotion render V1-StackNetworkWarm out/V1_StackNetworkWarm.mp4 --scale=1 --crf=16",
    "render:v2": "remotion render V2-StackNetworkViolet out/V2_StackNetworkViolet.mp4 --scale=1 --crf=16",
    "preview:v1": "remotion render V1-StackNetworkWarm out/V1_StackNetworkWarm_1080p.mp4 --scale=0.5 --crf=18",
    "preview:v2": "remotion render V2-StackNetworkViolet out/V2_StackNetworkViolet_1080p.mp4 --scale=0.5 --crf=18",
    "lint": "tsc"
  },
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  },
  "sideEffects": [
    "./src/load-fonts.ts"
  ]
}
