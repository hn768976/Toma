{
  "name": "twisted-ribbon",
  "version": "1.0.0",
  "description": "Twisted Ribbon Loop - Remotion + three.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lint": "tsc --noEmit",
    "verify:geometry": "esbuild scripts/verify-geometry.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-geometry.mjs --log-level=warning && node node_modules/.cache/verify-geometry.mjs",
    "verify:framing": "esbuild scripts/verify-framing.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-framing.mjs --log-level=warning && node node_modules/.cache/verify-framing.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "@remotion/cli": "4.0.515",
    "@remotion/three": "4.0.515",
    "postprocessing": "6.39.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
