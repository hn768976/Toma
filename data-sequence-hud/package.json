{
  "name": "data-sequence-hud",
  "version": "1.0.0",
  "description": "Sci-fi 'Data Sequence Analysis' HUD - Canvas 2D Remotion project (4K, 30 fps, 20 s)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render DataSequenceHUD-V1-Reference out/Data-Sequence-HUD_Version-1_Reference-Match_1080p.mp4 --scale=0.5",
    "render:v2": "remotion render DataSequenceHUD-V2-NeonPalette out/Data-Sequence-HUD_Version-2_Neon-Palette_1080p.mp4 --scale=0.5",
    "render:v1:4k": "remotion render DataSequenceHUD-V1-Reference out/Data-Sequence-HUD_Version-1_Reference-Match_4K.mp4",
    "render:v2:4k": "remotion render DataSequenceHUD-V2-NeonPalette out/Data-Sequence-HUD_Version-2_Neon-Palette_4K.mp4",
    "render:all": "npm run render:v1 && npm run render:v2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
