{
  "name": "tv-static",
  "version": "1.0.0",
  "description": "Analogue TV static — full-frame noise backgrounds (Remotion, 4K, 30fps, seamless 10s loop)",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "lint": "tsc",
    "render:mono:4k": "remotion render V1-TVStaticMono out/V1_TVStaticMono.mp4 --scale=1 --crf=11 --muted",
    "render:colour:4k": "remotion render V2-TVStaticColour out/V2_TVStaticColour.mp4 --scale=1 --crf=11 --muted",
    "render:mono:1080": "remotion render V1-TVStaticMono out/V1_TVStaticMono.mp4 --scale=0.5 --crf=11 --muted",
    "render:colour:1080": "remotion render V2-TVStaticColour out/V2_TVStaticColour.mp4 --scale=0.5 --crf=11 --muted"
  },
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
