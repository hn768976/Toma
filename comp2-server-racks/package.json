{
  "name": "comp2-server-racks",
  "version": "1.0.0",
  "description": "Composition 2 - server rack close-up (Remotion + Three.js, 3840x2160 @ 30 fps)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538",
    "three": "0.178.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render ServerRacks-V1 out/Comp2_ServerRacks_V1_1080p.mp4 --scale=0.5 --codec=h264 --crf=16",
    "render:v2": "remotion render ServerRacks-V2 out/Comp2_ServerRacks_V2_1080p.mp4 --scale=0.5 --codec=h264 --crf=16",
    "render:v1:4k": "remotion render ServerRacks-V1 out/Comp2_ServerRacks_V1_4K.mp4 --codec=h264 --crf=16",
    "render:v2:4k": "remotion render ServerRacks-V2 out/Comp2_ServerRacks_V2_4K.mp4 --codec=h264 --crf=16",
    "render:all": "npm run render:v1 && npm run render:v2"
  }
}
