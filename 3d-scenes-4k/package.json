{
  "name": "3d-scenes-4k",
  "version": "1.0.0",
  "description": "Two 4K (3840x2160) 30 fps Three.js compositions for Remotion: BarrelField and VoxelCube, each with V1 (reference match) and V2 (alternative).",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/cli": "4.0.538",
    "@remotion/media": "4.0.538",
    "@remotion/three": "4.0.538",
    "@remotion/zod-types": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538",
    "three": "0.178.0",
    "zod": "4.5.4",
    "mediabunny": "1.62.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:barrel-v1": "remotion render BarrelField-V1 out/Composition1_BarrelField_V1_1080p.mp4 --scale=0.5",
    "render:barrel-v2": "remotion render BarrelField-V2 out/Composition1_BarrelField_V2_1080p.mp4 --scale=0.5",
    "render:voxel-v1": "remotion render VoxelCube-V1 out/Composition2_VoxelCube_V1_1080p.mp4 --scale=0.5",
    "render:voxel-v2": "remotion render VoxelCube-V2 out/Composition2_VoxelCube_V2_1080p.mp4 --scale=0.5",
    "render:all": "npm run render:barrel-v1 && npm run render:barrel-v2 && npm run render:voxel-v1 && npm run render:voxel-v2",
    "render:barrel-v1:4k": "remotion render BarrelField-V1 out/Composition1_BarrelField_V1_4K.mp4",
    "render:barrel-v2:4k": "remotion render BarrelField-V2 out/Composition1_BarrelField_V2_4K.mp4",
    "render:voxel-v1:4k": "remotion render VoxelCube-V1 out/Composition2_VoxelCube_V1_4K.mp4",
    "render:voxel-v2:4k": "remotion render VoxelCube-V2 out/Composition2_VoxelCube_V2_4K.mp4"
  }
}
