{
  "name": "comp1-light-waves",
  "version": "1.0.0",
  "description": "Composition 1 - glowing light-wave arcs over a circuit rail (Remotion, Canvas 2D, 3840x2160 @ 30 fps)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538",
    "@remotion/tailwind-v4": "4.0.538",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render LightWaves-V1 out/Comp1_LightWaves_V1_1080p.mp4 --scale=0.5 --codec=h264 --crf=16",
    "render:v2": "remotion render LightWaves-V2 out/Comp1_LightWaves_V2_1080p.mp4 --scale=0.5 --codec=h264 --crf=16",
    "render:v1:4k": "remotion render LightWaves-V1 out/Comp1_LightWaves_V1_4K.mp4 --codec=h264 --crf=16",
    "render:v2:4k": "remotion render LightWaves-V2 out/Comp1_LightWaves_V2_4K.mp4 --codec=h264 --crf=16",
    "render:all": "npm run render:v1 && npm run render:v2"
  },
  "sideEffects": [
    "*.css"
  ]
}
