{
  "name": "data-sphere-network",
  "version": "1.0.0",
  "description": "Data Sphere Network Dive - 4K Remotion compositions (Canvas 2D 3D engine)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render V1-Data-Sphere-Network-Dive \"out/Version 1 - Data Sphere Network Dive.mp4\" --scale=0.5",
    "render:v2": "remotion render V2-Data-Sphere-Network-Corkscrew \"out/Version 2 - Data Sphere Network Dive (Corkscrew Camera).mp4\" --scale=0.5",
    "render:v1:4k": "remotion render V1-Data-Sphere-Network-Dive out/v1-data-sphere-network-4k.mp4",
    "render:v2:4k": "remotion render V2-Data-Sphere-Network-Corkscrew out/v2-data-sphere-network-4k.mp4",
    "still:4k": "remotion still V1-Data-Sphere-Network-Dive out/v1-frame195-4k.png --frame=195"
  },
  "sideEffects": [
    "*.css"
  ]
}
