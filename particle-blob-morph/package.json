{
  "name": "particle-blob-morph",
  "version": "1.0.0",
  "description": "Particle Blob Morph - 4K Remotion compositions (Three.js / WebGL2 shaders)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@types/three": "^0.181.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:v1": "remotion render V1-Particle-Blob-Morph-Cobalt \"out/Version 1 - Particle Blob Morph.mp4\" --scale=0.5",
    "render:v2": "remotion render V2-Particle-Blob-Morph-Ember \"out/Version 2 - Particle Blob Morph (Ember Palette).mp4\" --scale=0.5",
    "render:v1:4k": "remotion render V1-Particle-Blob-Morph-Cobalt out/v1-particle-blob-morph-4k.mp4",
    "render:v2:4k": "remotion render V2-Particle-Blob-Morph-Ember out/v2-particle-blob-morph-4k.mp4",
    "still:4k": "remotion still V1-Particle-Blob-Morph-Cobalt out/v1-frame0-4k.png --frame=0"
